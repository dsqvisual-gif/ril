generator client {
  provider        = "prisma-client-js"
  // Load `include` relations in one SQL query instead of one per relation.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String?
  name         String
  username     String?             @unique
  // Lookalike-free form of username (see src/lib/username.ts) to block confusable nicknames.
  usernameKey  String?
  image        String?
  /// Set once the user proved they own the email (a code from it, or Google).
  emailVerified DateTime?
  /// Activity, from a ping the app sends once a minute while it is open.
  lastSeenAt    DateTime?
  activeMinutes Int                @default(0)
  activeDays    Int                @default(0)
  /// Consecutive days with at least one visit, by the Almaty calendar.
  useStreak     Int                @default(0)
  bestUseStreak Int                @default(0)
  lastActiveOn  String?
  /// When the person accepted the terms of use and the processing of personal data.
  termsAcceptedAt DateTime?
  /// Profile photo uploaded by the person: a 256px JPEG. Bumping the version changes its URL.
  avatar        Bytes?
  avatarVersion Int                @default(0)
  /// Colour theme id from src/lib/themes.ts.
  theme         String?
  /// When the first-run tour was finished or skipped; null shows it.
  onboardedAt   DateTime?
  /// Morning email with the day's plan.
  digestEnabled Boolean           @default(false)
  /// Day (YYYY-MM-DD, user's time) the last digest went out, so it is sent once a day.
  lastDigestOn  String?
  /// IANA time zone reported by the browser, for "today" in emails.
  timeZone      String?
  reminders     Reminder[]
  /// "Mom mode": a baby tracker next to the planner, with its own look.
  momMode       Boolean           @default(false)
  /// Emails about upcoming vaccinations and doctor visits.
  healthEmails  Boolean           @default(true)
  children      Child[]
  childAccess   ChildAccess[]
  createdAt    DateTime            @default(now())
  tasks        Task[]
  achievements AchievementUnlock[]
  sentRequests Friendship[]        @relation("FriendRequester")
  receivedRequests Friendship[]    @relation("FriendAddressee")
  taskShares   TaskShare[]
  taskViews    TaskViewerState[]
  goals        Goal[]
  companies    CompanyMember[]
  companyTasksAssigned CompanyTask[] @relation("CompanyTaskAssignee")
  companyTasksCreated  CompanyTask[] @relation("CompanyTaskCreator")

  @@index([usernameKey])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status          String
  requesterAlias  String?
  addresseeAlias  String?
  createdAt       DateTime @default(now())
  requester   User     @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Task {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String
  originDate String?
  time      String?
  important Boolean     @default(false)
  urgent    Boolean     @default(false)
  done      Boolean     @default(false)
  doneAt    DateTime?
  createdAt DateTime    @default(now())
  note      String?
  shares    TaskShare[]
  viewerStates TaskViewerState[]
  items     TaskItem[]

  @@index([userId, date])
}

/// A checklist line inside a task, e.g. one product in "buy groceries".
/// A task with items closes only when every item is checked.
model TaskItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId, position])
}

model TaskShare {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskViewerState {
  id         String    @id @default(cuid())
  userId     String
  taskId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  keptOn     String?
  archived   Boolean   @default(false)
  archivedAt DateTime?

  @@unique([userId, taskId])
  @@index([userId, archived])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AchievementUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

model Goal {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  why       String?
  deadline  String?
  /// How progress is measured: number | feeling ("steps" is legacy, converted on read).
  kind      String      @default("feeling")
  /// For kind "number": how much to reach, and in what (книг, км, слов).
  target    Float?
  unit      String?
  /// For kind "feeling": the user's own estimate, 0–100.
  selfProgress Int?
  doneAt    DateTime?
  createdAt DateTime    @default(now())
  steps     GoalStep[]
  entries   GoalEntry[]

  @@index([userId])
}

/// A planned piece of a goal, ticked off when done.
model GoalStep {
  id        String    @id @default(cuid())
  goalId    String
  goal      Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([goalId])
}

/// A free-form note about what was done toward a goal.
model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  text      String
  /// For "number" goals: how much this entry adds.
  amount    Float?
  /// For "feeling" goals: the estimate given with this entry, 0–100.
  progress  Int?
  createdAt DateTime @default(now())

  @@index([goalId])
}

/// A team workspace. `plan` is "free" for now; paid plans come later.
model Company {
  id        String          @id @default(cuid())
  name      String
  plan      String          @default("free")
  createdAt DateTime        @default(now())
  members   CompanyMember[]
  tasks     CompanyTask[]
}

/// role: owner | admin | member. status: invited | active.
model CompanyMember {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  role        String   @default("member")
  status      String   @default("invited")
  invitedById String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, status])
}

/// status: todo | doing | done.
model CompanyTask {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  note        String?
  assigneeId  String?
  creatorId   String
  startDate   String?
  deadline    String?
  status      String    @default("todo")
  important   Boolean   @default(false)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("CompanyTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User      @relation("CompanyTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([assigneeId, status])
}

/// One-time code sent by email. purpose: register | login | reset.
/// For "register" the pending account (name, username, passwordHash) waits in payload.
model EmailCode {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  payload   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

/// Something that repeats (a checkup four times a year): emailed ahead and added to the planner.
model Reminder {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  /// Repeats every `everyCount` `everyUnit`s: day | week | month | year.
  everyCount       Int
  everyUnit        String
  /// Next occurrence, YYYY-MM-DD.
  nextDate         String
  remindDaysBefore Int      @default(3)
  addToPlanner     Boolean  @default(true)
  /// Occurrence (nextDate) already emailed about / already put into the planner.
  lastNotifiedFor  String?
  lastPlannedFor   String?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model Child {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// YYYY-MM-DD
  birthDate String
  /// "girl" | "boy" | null
  sex       String?
  createdAt DateTime     @default(now())
  events    BabyEvent[]
  growth    GrowthRecord[]
  foods     FoodIntro[]
  access    ChildAccess[]
  health    BabyHealth[]

  @@index([userId])
}

/// kind: sleep | feed | diaper. A running timer has no endedAt.
/// data — feed: {type: breast|bottle, side?: left|right, ml?, milk?: formula|breastmilk}; diaper: {pee, poo}.
model BabyEvent {
  id        String    @id @default(cuid())
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind      String
  startedAt DateTime
  endedAt   DateTime?
  data      Json?
  note      String?
  /// Who made the record, when the child is shared.
  byUserId  String?
  createdAt DateTime  @default(now())

  @@index([childId, startedAt])
}

model GrowthRecord {
  id       String  @id @default(cuid())
  childId  String
  child    Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date     String
  weightG  Int?
  heightCm Float?
  headCm   Float?

  @@index([childId, date])
}

/// A complementary food being introduced. status: trying | ok | reaction | later.
model FoodIntro {
  id        String     @id @default(cuid())
  childId   String
  child     Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  product   String
  category  String
  /// YYYY-MM-DD of the first try
  startDate String
  status    String     @default("trying")
  note      String?
  createdAt DateTime   @default(now())
  tries     FoodTry[]

  @@index([childId])
}

/// One serving of a food being introduced. reaction: none | skin | tummy | other.
model FoodTry {
  id       String    @id @default(cuid())
  foodId   String
  food     FoodIntro @relation(fields: [foodId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date     String
  amount   String?
  reaction String    @default("none")
  note     String?

  @@index([foodId])
}

/// Another person (dad, grandma, nanny) who tracks the same child. status: invited | active.
model ChildAccess {
  id          String   @id @default(cuid())
  childId     String
  userId      String
  status      String   @default("invited")
  invitedById String?
  createdAt   DateTime @default(now())
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([childId, userId])
  @@index([userId, status])
}

/// A vaccination or doctor visit. kind: vaccine | visit.
model BabyHealth {
  id               String   @id @default(cuid())
  childId          String
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind             String
  title            String
  /// YYYY-MM-DD
  date             String
  done             Boolean  @default(false)
  note             String?
  remindDaysBefore Int      @default(3)
  lastNotifiedFor  String?
  createdAt        DateTime @default(now())

  @@index([childId, date])
}

/// An error users ran into, grouped by fingerprint: one row per distinct error, with a count.
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  /// "server" or "client".
  source      String
  message     String
  stack       String?
  /// Where it happened: the route on the server, the page path in the browser.
  path        String?
  /// Extra details such as the route type or the browser.
  context     String?
  digest      String?
  count       Int       @default(1)
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  /// "open", "fixed" (comes back to "open" if it happens again) or "ignored".
  status      String    @default("open")
  fixedAt     DateTime?
  fixNote     String?

  @@index([status, lastSeen])
}

/// One-time handoff from a website sign-in (e.g. Google) back to the mobile app.
/// The app trades the code for its own token within a few minutes.
model MobileAuthCode {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
